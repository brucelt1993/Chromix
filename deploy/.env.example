# 复制为 .env 后修改；./deploy.sh 会自动生成。
# 访问令牌：管理界面、API 和 CDP 网关都要用它（请求头 X-Chromix-Token）
CHROMIX_MANAGER_TOKEN=change-me-to-a-long-random-string

# 启用 HTTPS（docker compose --profile https）时填写已解析到本机的域名
DOMAIN=

# 不用域名时，管理器端口绑定的宿主地址：127.0.0.1（SSH 隧道）或 0.0.0.0（直接公网，明文）
BIND_ADDR=127.0.0.1
MANAGER_PORT=8820

TZ=Asia/Shanghai
SHM_SIZE=2gb
XVFB_RESOLUTION=1920x1080x24
